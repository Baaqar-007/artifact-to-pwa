{
  "name": "@baaqar/artifact-to-pwa",
  "version": "2.0.0",
  "description": "Convert any Claude artifact (HTML/React/JSX) or public URL into a native Windows .exe — no compiler, no App Store",
  "type": "module",
  "publishConfig": { "access": "public" },
  "bin": {
    "@baaqar/artifact-to-pwa": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "template/",
    "README.md"
  ],
  "keywords": [
    "pwa", "claude", "artifact", "cli",
    "electron", "windows", "exe", "desktop",
    "react", "jsx", "standalone", "converter"
  ],
  "author": "",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "dependencies": {
    "chalk":       "^5.3.0",
    "commander":   "^12.1.0",
    "esbuild":     "^0.21.0",
    "extract-zip": "^2.0.1",
    "png-to-ico":  "^2.1.8",
    "rcedit":      "^4.0.0"
  }
}
